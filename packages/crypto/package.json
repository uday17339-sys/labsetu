{
  "name": "@labsetu/crypto",
  "version": "0.1.0",
  "private": true,
  "description": "Cryptographic primitives: envelope encryption, blind indexes, canonical JSON for audit hashing, password hashing.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
