# =============================================================================
# LabSetu — environment contract
# Copy to .env and fill in. NEVER commit a real .env.
#   cp .env.example .env
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# =============================================================================

NODE_ENV=development
LOG_LEVEL=debug

# --- Data residency ----------------------------------------------------------
# The API asserts this at boot. DPDP posture: India-only. See ARCHITECTURE.md §9.
DATA_RESIDENCY_REGION=ap-south-1
ALLOWED_RESIDENCY_REGIONS=ap-south-1,ap-south-2

# --- API ---------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000
# Comma-separated exact origins. No wildcards in production.
CORS_ORIGINS=http://localhost:3100

# --- Database ----------------------------------------------------------------
# Runtime role: NO BYPASSRLS. Tenant isolation depends on this. See ADR 0002.
# Host port 55432 (not 5432) so a locally-installed Postgres is undisturbed.
DATABASE_URL=postgresql://labsetu_app:labsetu_app_dev_password@localhost:55432/labsetu?schema=public&connection_limit=20&pool_timeout=20
# Migration/owner role: DDL + RLS policy management only. Never used at runtime.
DATABASE_ADMIN_URL=postgresql://labsetu:labsetu_dev_password@localhost:55432/labsetu?schema=public

# --- Redis / queues ----------------------------------------------------------
REDIS_URL=redis://:labsetu_dev_password@localhost:6379

# --- Object storage ----------------------------------------------------------
# Local dev points at MinIO; production at S3 in an allowed region.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=labsetu
S3_SECRET_ACCESS_KEY=labsetu_dev_password
S3_FORCE_PATH_STYLE=true
S3_BUCKET_RAW=labsetu-raw
S3_BUCKET_REPORTS=labsetu-reports
S3_BUCKET_ATTACHMENTS=labsetu-attachments

# --- Auth / tokens -----------------------------------------------------------
# 32+ random bytes, base64. Rotate via JWT_SECRET_PREVIOUS for zero-downtime.
JWT_SECRET=CHANGE_ME_generate_a_32_byte_base64_secret_before_any_real_use
JWT_SECRET_PREVIOUS=
JWT_ACCESS_TTL=15m
JWT_ISSUER=labsetu
JWT_AUDIENCE=labsetu-api
REFRESH_TOKEN_TTL_DAYS=30
# Signing token for e-signatures: single-use, entity-bound. Keep this short.
SIGNING_TOKEN_TTL_SECONDS=300

# --- Encryption --------------------------------------------------------------
# Dev uses a local master key. Production MUST use AWS KMS (KMS_KEY_ID) and leave
# ENCRYPTION_MASTER_KEY empty — see ADR 0005.
ENCRYPTION_PROVIDER=local
ENCRYPTION_MASTER_KEY=CHANGE_ME_generate_a_32_byte_base64_key_before_any_real_use
KMS_KEY_ID=
# Deriving blind indexes for encrypted-field lookup. Changing this invalidates
# every existing index and requires a rebuild.
BLIND_INDEX_KEY=CHANGE_ME_generate_a_32_byte_base64_key_before_any_real_use

# --- Audit -------------------------------------------------------------------
AUDIT_CHAIN_VERIFY_CRON=0 2 * * *
# Anchors the daily chain head to WORM storage so tampering is detectable by a
# third party, not just by us. See COMPLIANCE.md §3.4.
AUDIT_ANCHOR_ENABLED=false
AUDIT_ANCHOR_BUCKET=labsetu-raw

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# --- Web ---------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=LabSetu
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Notifications (stubbed in v1) -------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="LabSetu <no-reply@labsetu.local>"
WHATSAPP_PROVIDER=none
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# =============================================================================
# GATEWAY (apps/gateway) — runs on-premises in the lab, not in the cloud.
# Keep this block in a separate .env on the gateway machine.
# =============================================================================
GATEWAY_API_URL=http://localhost:4000
GATEWAY_DEVICE_ID=
GATEWAY_DEVICE_KEY=
# HMAC key issued at enrolment; shown exactly once.
GATEWAY_DEVICE_SECRET=
GATEWAY_CONFIG_PATH=./gateway.config.json
GATEWAY_OUTBOX_PATH=./data/outbox
# Sized for a 72-hour outage. See INSTRUMENT_INTEGRATION.md §9.
GATEWAY_OUTBOX_MAX_ITEMS=50000
GATEWAY_HEARTBEAT_SECONDS=60
GATEWAY_LOG_LEVEL=info
