# =============================================================================
# LabSetu — production environment
#
#   node scripts/setup-prod-env.mjs          # generates .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# NEVER commit the generated .env.production.
# =============================================================================

# The public hostname. A real domain pointing at this machine gets automatic
# HTTPS from Caddy. Use ":80" to run plain HTTP locally.
PUBLIC_HOST=localhost

LOG_LEVEL=info

# --- data residency (asserted at boot) ---------------------------------------
DATA_RESIDENCY_REGION=ap-south-1
ALLOWED_RESIDENCY_REGIONS=ap-south-1,ap-south-2

# --- database ----------------------------------------------------------------
POSTGRES_USER=labsetu
POSTGRES_DB=labsetu
POSTGRES_PASSWORD=GENERATED
# Runtime role — NO BYPASSRLS. Created by packages/db/docker/init.
DATABASE_URL=postgresql://labsetu_app:GENERATED_APP@postgres:5432/labsetu?schema=public&connection_limit=20&pool_timeout=20
# Owner role — migrations and RLS policies only.
DATABASE_ADMIN_URL=postgresql://labsetu:GENERATED@postgres:5432/labsetu?schema=public

# --- redis -------------------------------------------------------------------
REDIS_PASSWORD=GENERATED

# --- object storage ----------------------------------------------------------
S3_ACCESS_KEY_ID=labsetu
S3_SECRET_ACCESS_KEY=GENERATED

# --- secrets -----------------------------------------------------------------
JWT_SECRET=GENERATED
# Changing this invalidates every existing blind index and requires a rebuild.
BLIND_INDEX_KEY=GENERATED

# --- encryption --------------------------------------------------------------
# PREFERRED: keys never leave AWS KMS.
#   ENCRYPTION_PROVIDER=kms
#   KMS_KEY_ID=arn:aws:kms:ap-south-1:...:key/...
#
# Self-hosted without KMS: the master key lives in this file, so anyone who can
# read it can decrypt patient identifiers. Opting in is deliberate and the API
# warns on every boot.
ENCRYPTION_PROVIDER=local
ENCRYPTION_MASTER_KEY=GENERATED
ENCRYPTION_LOCAL_ACK=i-understand-the-master-key-is-in-the-environment
KMS_KEY_ID=

# --- rate limiting -----------------------------------------------------------
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
