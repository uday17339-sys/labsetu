# Build tools are devDependencies: TypeScript, the Prisma CLI, tsx.
#
# Hosts that set NODE_ENV=production during install — Vercel does — make npm
# omit devDependencies, and the build then fails with "tsc: command not found"
# or "nest: command not found". The error names the symptom, nowhere near the
# cause.
#
# Setting this here rather than as an install flag means it holds whatever
# install command the host actually runs, including a dashboard override that
# silently replaces the one in vercel.json.
include=dev
